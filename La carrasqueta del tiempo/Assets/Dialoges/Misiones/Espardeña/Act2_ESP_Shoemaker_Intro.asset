  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 978a5531ed9fd1152ad197b83c124cb9, type: 3}
  m_Name: Act2_ESP_Shoemaker_Intro
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  originalDialogue: {fileID: 0}
  defaultSprite: {fileID: 0}
  lines:
  - speakerName: Joaquin
    lineText: "Que b\xE9, est\xE0 obert!"
    expression: {fileID: 3684638748939831445, guid: 423e9c4ed331f7ba7be40b4446b71b54, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Antonio
    lineText: "Bon dia xic! Qu\xE8 se te perd per ac\xED?"
    expression: {fileID: -7163864861592193100, guid: 39f455c862bdc2d69a9d37676480ea21, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Joaquin
    lineText: "Bon dia. Necessite un poc d\u2019espart. Per casualitat no en tindr\xE0s
      de sobra?"
    expression: {fileID: -5128461551337143105, guid: d9b9db733e855fc538182399fa6cb6fc, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Antonio
    lineText: "Espart? I per a qu\xE8 el vols, si es pot saber?"
    expression: {fileID: 2034427693296661028, guid: eb034a48146884376a653a7c523df0a9, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Joaquin
    lineText: Per a fer una torxa.
    expression: {fileID: -6552298411299982458, guid: cadc1d4159db512ed80002fe8fdffee7, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Antonio
    lineText: "Jajaja! Els xicons i els vostres jocs... Va, d\u2019acord, te\u2019n
      donar\xE9 una mica que tinc per ac\xED."
    expression: {fileID: 2034427693296661028, guid: eb034a48146884376a653a7c523df0a9, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Antonio
    lineText: "Per\xF2 les coses no s\xF3n gratis. Per qu\xE8 no m\u2019ajudes un
      poc? Vols aprendre a fer espardenyes?"
    expression: {fileID: -7163864861592193100, guid: 39f455c862bdc2d69a9d37676480ea21, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Joaquin
    lineText: "Espardenyes? Per\xF2 aix\xF2 no \xE9s molt complicat?"
    expression: {fileID: 3198480329992687461, guid: 5306aceea206f7db480487b741e7cd5b, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Antonio
    lineText: "No home, no! Tu segueixes les meues indicacions i ja vor\xE0s que
      r\xE0pid se\u2019n fa una."
    expression: {fileID: 3394518141796890859, guid: 702a897522d01f961a34b51c7ce5f4e1, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Antonio
    lineText: "Va, prepara\u2019t. Dona-li a les tecles al ritme i vore\u2019m qu\xE8
      tal se\u2019t dona."
    expression: {fileID: 2034427693296661028, guid: eb034a48146884376a653a7c523df0a9, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 1
    minigame: Minijuego_Espard
  conditions:
  - Act2_Q_ESP_Started
