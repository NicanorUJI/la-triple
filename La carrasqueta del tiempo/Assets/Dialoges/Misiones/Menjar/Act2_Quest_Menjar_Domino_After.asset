    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Josefina
    lineText: "Si es que els xicons de hui en dia son molt espavilats. Ja ho deia
      Maria Pilar que tu vas a ser metge o alg\xFAn treball d\u2019aquestos importants."
    expression: {fileID: 5031953502039587451, guid: ca73ec9276f1fdc40ad7139674a1f748, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Josefina
    lineText: "Ala, ac\xED tens el pot de mel, te l\u2019has guanyat. Tira, per\xF2
      torna un altre dia a jugar una altra vegada. A la pr\xF2xima juguem al cinquet
      i ja veur\xE0s com no ens guanyes."
    expression: {fileID: -7372192891005804176, guid: cd5e1878ba1097dacb04ec7584989e1a, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
