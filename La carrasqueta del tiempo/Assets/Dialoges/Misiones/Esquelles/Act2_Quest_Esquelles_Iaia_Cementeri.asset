  m_Script: {fileID: 11500000, guid: 978a5531ed9fd1152ad197b83c124cb9, type: 3}
  m_Name: Act2_Quest_Esquelles_Iaia_Cementeri
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  originalDialogue: {fileID: 0}
  defaultSprite: {fileID: 0}
  joaquinDefault: {fileID: 0}
  lines:
  - speakerName: Maria Pilar
    lineText: Hola xiquet.
    expression: {fileID: 7005228422062525146, guid: 5e26fc60400b0e384bbede9f5b9696da, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "Hola iaia. Qu\xE8 fas ac\xED?"
    expression: {fileID: -6552298411299982458, guid: cadc1d4159db512ed80002fe8fdffee7, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: 'No res, he vingut a parlar amb el teu avi i dir-li quan has crescut. '
    expression: {fileID: -2893953108195195402, guid: d85e6c19b582bc7919d58c00b9643166, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "I tu, Joaquin? Qu\xE8 fas ac\xED?"
    expression: {fileID: 2598321381096221530, guid: 95d2f50c9fc481e0ebcbe7c44fc05a0b, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: He vingut a buscar-te. Et volia preguntar una cosa.
    expression: {fileID: 3198480329992687461, guid: 5306aceea206f7db480487b741e7cd5b, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "Iaia, com \xE9s que et vas enamorar del iaio?"
    expression: {fileID: 3198480329992687461, guid: 5306aceea206f7db480487b741e7cd5b, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "I per qu\xE8 preguntes aix\xED de sobte?"
    expression: {fileID: 7005228422062525146, guid: 5e26fc60400b0e384bbede9f5b9696da, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "No s\xE9. M\u2019ha vingut la curiositat\u2026"
    expression: {fileID: 3684638748939831445, guid: 423e9c4ed331f7ba7be40b4446b71b54, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Tu sempre has sigut un xiquet molt curi\xF3s. A veure que recorde\u2026"
    expression: {fileID: 2598321381096221530, guid: 95d2f50c9fc481e0ebcbe7c44fc05a0b, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Ai recorde que fa uns 50 anys, quan la teua iaia encara era jove.
      El teu iaio era una persona molt despistada, per\xF2 tenia el seu encant. Recorde
      que una vegada em va vindre amb una polsera. "
    expression: {fileID: 4462475327784966996, guid: c5ac9a984102a154589fe3cfa5884646, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Em va fer tanta gr\xE0cia la seua expressi\xF3 mentre em donava aquell
      regal, que en eixe moment vaig sentir que era l\u2019indicat."
    expression: {fileID: 4462475327784966996, guid: c5ac9a984102a154589fe3cfa5884646, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: Que bonic.
    expression: {fileID: 3684638748939831445, guid: 423e9c4ed331f7ba7be40b4446b71b54, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "A qu\xE8 s\xED? El teu iaio era un home molt bo. Em recordes molt
      a ell."
    expression: {fileID: 2598321381096221530, guid: 95d2f50c9fc481e0ebcbe7c44fc05a0b, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "A s\xED?"
    expression: {fileID: -5128461551337143105, guid: d9b9db733e855fc538182399fa6cb6fc, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "S\xED. Ell estaria molt orgull\xF3s de tu."
    expression: {fileID: 2609695413090427051, guid: 7beecc0da340a265083fa00c5be08c62, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_Q_ESQUELLES_TALKED_IAIA
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: Bueno canviant de tema...
    expression: {fileID: 2598321381096221530, guid: 95d2f50c9fc481e0ebcbe7c44fc05a0b, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_Q_ESQUELLES_TALKED_IAIA
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Si est\xE0s avorrit recorde que al col\xB7legi hi havia uns xiquets
      venent polseres. Per qu\xE8 no vas all\xED a jugar una estona amb ells?\r\n"
    expression: {fileID: 7005228422062525146, guid: 5e26fc60400b0e384bbede9f5b9696da, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_Q_ESQUELLES_TALKED_IAIA
    startsMinigame: 0
    minigame: 
  conditions:
  - Act2_Q_ESQUELLES_TalkedToRaul
