    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: Bon dia.
    expression: {fileID: 21300000, guid: 2b246f36b00eb679ca770ee62b85ed11, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Alcalde
    lineText: "Bon dia, xicon. Qu\xE8 passa?"
    expression: {fileID: 1597853712253449665, guid: 529bae17d383f9bd883f8df2c24b849b, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "Saps qui t\xE9 la clau de l\u2019ermita de Santa B\xE0rbara?"
    expression: {fileID: -5128461551337143105, guid: d9b9db733e855fc538182399fa6cb6fc, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Alcalde
    lineText: "La clau? Per a qu\xE8 vols tu la clau?"
    expression: {fileID: 1519292624816307631, guid: c8e8baf8578fc1d45ab4ee68b1c96e2a, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "\xC9s que he de\u2026 fer un treball per al col\xB7legi. I l\u2019ermita
      no est\xE0 oberta."
    expression: {fileID: 3684638748939831445, guid: 423e9c4ed331f7ba7be40b4446b71b54, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Alcalde
    lineText: "A no? Fa molt que no pase per all\xED. Hmm\u2026"
    expression: {fileID: -5406564271734706521, guid: ee4b25bbe12e56de0b3062bf88ba071a, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Alcalde
    lineText: "Jaja, vale xic, et dir\xE9 on guarde la clau si aconsegueixes guanyar-me
      a un joc. "
    expression: {fileID: -5406564271734706521, guid: ee4b25bbe12e56de0b3062bf88ba071a, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Alcalde
    lineText: "\xC9s el joc de la solterona. A vore si tens sort."
    expression: {fileID: -5406564271734706521, guid: ee4b25bbe12e56de0b3062bf88ba071a, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
