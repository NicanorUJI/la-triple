    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Alcalde
    lineText: "Des de generacions, sempre guardem la clau en una pedra al costat
      de la creu en l\u2019ermita per evitar que es perda. "
