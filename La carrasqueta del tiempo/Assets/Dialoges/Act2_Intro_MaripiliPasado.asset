%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 978a5531ed9fd1152ad197b83c124cb9, type: 3}
  m_Name: Act2_Intro_MaripiliPasado
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  originalDialogue: {fileID: 0}
  defaultSprite: {fileID: -1807645480230456300, guid: 1007b9b7e18ff7125acd0c1d293d16ca, type: 3}
  joaquinDefault: {fileID: 0}
  lines:
  - speakerName: "Joaqu\xEDn"
    lineText: "Iaia! Iaia! On est\xE0s?!"
    expression: {fileID: -5703435808359689965, guid: 60b817b8f671b42c2ac4e3c85d07b923, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: Xiquet tu on vas pegant eixos crits amb tanta presa? No pots veure
      que hi ha gent al carrer??
    expression: {fileID: 2575970253454553181, guid: 4b415fae88a3f16e985155be15f2c9d3, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Tu de qui eres? No t\u2019havia vist mai per aquest poble i jo conec
      a tot el m\xF3n."
    expression: {fileID: 2575970253454553181, guid: 4b415fae88a3f16e985155be15f2c9d3, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "Jo s\xF3c de la Maria Pilar. S\xF3c el seu n\xE9t."
    expression: {fileID: 8517940295573926053, guid: c3b1402a4e92366fb8ab7e4d9cf6129b, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Maria Pilar? En tot el poble sol hi ha una Maria Pilar i eixa s\xF3c
      jo. Que jo s\xE0piga no tinc cap n\xE9t encara."
    expression: {fileID: -8926846126903474245, guid: 81c29258031bb7894a4321dc2d219bed, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "(\u2026La carrasqueta m'ha fet viatjar al passat...)"
    expression: {fileID: -5703435808359689965, guid: 60b817b8f671b42c2ac4e3c85d07b923, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "B\xE9, aix\xF2 ara no importa! Necessite ajuda! He vist un \xF3s a
      la carrasqueta! Era enorme i feia molta por!"
    expression: {fileID: 6622962485173151977, guid: 9dc4bdc194db27abd8c66754407f8a44, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Un \xF3s? Oh no! Just quan estem preparant la festa de l\u2019Onso. "
    expression: {fileID: 2575970253454553181, guid: 4b415fae88a3f16e985155be15f2c9d3, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Xiquet, em vas a ajudar a espantar-lo del poble. No podem permetre
      que un \xF3s fa\xE7a malb\xE9 la festa. "
    expression: {fileID: 2575970253454553181, guid: 4b415fae88a3f16e985155be15f2c9d3, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_MARIPILI_INTRO_END
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "Per\xF2 jo no em vull arrimar a l\u2019\xF3s. Fa molta por!"
    expression: {fileID: -5703435808359689965, guid: 60b817b8f671b42c2ac4e3c85d07b923, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_MARIPILI_INTRO_END
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Que no, tranquil. Tu no t\u2019arrimar\xE0s a ning\xFAn \xF3s. Per\xF2
      necessite que m\u2019ajudes a espantar-lo. A m\xE9s, si demanem ajuda a altres,
      escampar\xE0 el p\xE0nic al poble i ja no hi haur\xE0 festa."
    expression: {fileID: 8833923459880237216, guid: e3685ac615ce7f0809ecf83758807687, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_MARIPILI_INTRO_END
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Per un any que em deixen ajudar amb els preparatius\u2026 No podem
      deixar que aix\xF2 passe!"
    expression: {fileID: 2575970253454553181, guid: 4b415fae88a3f16e985155be15f2c9d3, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_MARIPILI_INTRO_END
    startsMinigame: 0
    minigame: 
  - speakerName: "Joaqu\xEDn"
    lineText: "I com farem aix\xF2?"
    expression: {fileID: 9125249484933913112, guid: 14c58c64c003fa97ca1c2795a3c4160a, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_MARIPILI_INTRO_END
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Se m\u2019ocorre una cosa... "
    expression: {fileID: 2575970253454553181, guid: 4b415fae88a3f16e985155be15f2c9d3, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_MARIPILI_INTRO_END
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Anem a veure si la tradici\xF3 de la festa de l\u2019Onso tamb\xE9
      serveix per a \xF3ssos de veritat."
    expression: {fileID: 2575970253454553181, guid: 4b415fae88a3f16e985155be15f2c9d3, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_MARIPILI_INTRO_END
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Anava a anar a arreplegar les coses necess\xE0ries per a preparar
      la festa, per\xF2 pots anar tu que ets m\xE9s jove, i jo m\u2019encarregue
      de preparar-lo tot."
    expression: {fileID: 2575970253454553181, guid: 4b415fae88a3f16e985155be15f2c9d3, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_MARIPILI_INTRO_END
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "D\u2019acord?"
    expression: {fileID: 2575970253454553181, guid: 4b415fae88a3f16e985155be15f2c9d3, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT2_MARIPILI_INTRO_END
    startsMinigame: 0
    minigame: 
  conditions:
  - Act1_FirstTravelPast
