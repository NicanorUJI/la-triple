  m_Script: {fileID: 11500000, guid: 978a5531ed9fd1152ad197b83c124cb9, type: 3}
  m_Name: Act1_Intro_MariaPilar
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  originalDialogue: {fileID: 0}
  defaultSprite: {fileID: 0}
  lines:
  - speakerName: Joaquin
    lineText: Hola iaia!
    expression: {fileID: -6552298411299982458, guid: cadc1d4159db512ed80002fe8fdffee7, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: Hola Joaquin. Quant de temps. Te he trobat a faltar.
    expression: {fileID: 7005228422062525146, guid: a34b79527556fa054bc051ac2a70c857, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Joaquin
    lineText: "Ai iaia, jo tamb\xE9 t\u2019he trobat a faltar."
    expression: {fileID: 3684638748939831445, guid: 423e9c4ed331f7ba7be40b4446b71b54, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Podries vindre a visitar m\xE9s sovint a visitarme, que jo ac\xED
      em trobe molt asoles i trobe a faltar al meu net preferit. Vine i dona\u2019m
      un besset."
    expression: {fileID: 7005228422062525146, guid: a34b79527556fa054bc051ac2a70c857, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Joaquin
    lineText: "S\xED iaia si, feia temps que no ven\xEDa al poble i jo tamb\xE9 el
      trobava a faltar."
    expression: {fileID: 167803326818533104, guid: 2b246f36b00eb679ca770ee62b85ed11, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Si et sembla, posa les teues coses a la teua habitaci\xF3 i quan ho
      tingues tot ordenat vine que vull que em fages un favor."
    expression: {fileID: 7005228422062525146, guid: a34b79527556fa054bc051ac2a70c857, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Ara vaig a anar a preparar el dinar, que de segur que tens molta fam
      despr\xE9s del viatge."
    expression: {fileID: 7005228422062525146, guid: a34b79527556fa054bc051ac2a70c857, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Tu per qu\xE8 no t\u2019en vas a la Carrasqueta a arreplegar una cistella
      que me\u2019n vaig deixar l\u2019altre dia quan vagi anar amb la Chelo. Saps
      com arribar no? Segueix el cam\xED com quan eres menut i anaven a recollir
      rovellons amb els teus cosins, i aix\xED tamb\xE9 te dona l\u2019aire una miqueta."
    expression: {fileID: 7005228422062525146, guid: a34b79527556fa054bc051ac2a70c857, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Joaquin
    lineText: "Vale iaia, pues ara torne. Estar\xE9 ac\xED abans del dinar."
    expression: {fileID: -6552298411299982458, guid: cadc1d4159db512ed80002fe8fdffee7, type: 3}
    isPlayerSpeaking: 1
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Molt be xiquet, si es que sempre has estat ple d\u2019energia. Encara
      te'n recordes com anar, no?"
    expression: {fileID: 7005228422062525146, guid: a34b79527556fa054bc051ac2a70c857, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Joaquin
    lineText: "Per supost que s\xED iaia!"
    expression: {fileID: 7005228422062525146, guid: a34b79527556fa054bc051ac2a70c857, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 0
    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maria Pilar
    lineText: "Pues tira-l\xED."
    expression: {fileID: 7005228422062525146, guid: a34b79527556fa054bc051ac2a70c857, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
    choiceA: {fileID: 0}
    choiceB: {fileID: 0}
    choiceC: {fileID: 0}
    choiceD: {fileID: 0}
    hasReward: 1
    reward: ACT1_INTRO_END
    startsMinigame: 0
    minigame: 
  conditions: []
