    reward: 
    startsMinigame: 0
    minigame: 
  - speakerName: Maripili
    lineText: "Ens far\xE0 falta espart per a les torxes, una llan\xE7a, menjar per
      a calmar-lo... i alguna cosa m\xE9s que ja pensarem."
    expression: {fileID: -2354228602472572489, guid: 137b836fd6e1645439f1250705b1e5b4, type: 3}
    isPlayerSpeaking: 0
    isChoice: 0
